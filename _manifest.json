{
  "manifest_version": 2,
  "id": "feiyu.voice-cover",
  "version": "0.2.0",
  "name": "麦弦",
  "description": "麦弦（MaiChord）：点歌翻唱、清唱猜歌与本地音色工作室，群里点一首歌，用麦麦的声音唱出来",
  "author": {
    "name": "Allure-Gui",
    "url": "https://github.com/Allure-Gui"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Allure-Gui/feiyu-cover-plugin",
    "homepage": "https://github.com/Allure-Gui/feiyu-cover-plugin",
    "documentation": "https://github.com/Allure-Gui/feiyu-cover-plugin/blob/main/README.md",
    "issues": "https://github.com/Allure-Gui/feiyu-cover-plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.13.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    }
  ],
  "plugin_type": "media",
  "capabilities": [
    "config.get",
    "send.hybrid",
    "send.text",
    "send.image",
    "chat.get_all_streams",
    "message.get_recent",
    "maisaka.context.append",
    "render.html2png",
    "desktop_pet.say",
    "desktop_pet.play_event"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "music",
      "background": "#DBE7FB"
    }
  }
}