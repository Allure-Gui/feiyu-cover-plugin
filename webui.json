{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages"
  ],
  "pages": [
    {
      "id": "studio",
      "title": "麦弦",
      "description": "麦弦声学工作室：音色路由、试听与干声训练",
      "placement": "sidebar",
      "icon": "puzzle",
      "mode": "custom",
      "entry": "webui/index.html",
      "layout": "viewport",
      "queries": {
        "state": {
          "api": "jingge_state"
        },
        "system": {
          "api": "jingge_system",
          "parameters": {
            "refresh": {
              "type": "boolean",
              "required": false
            }
          }
        },
        "search": {
          "api": "jingge_search",
          "parameters": {
            "keyword": {
              "type": "string",
              "required": true,
              "max_length": 200
            },
            "limit": {
              "type": "integer",
              "required": false,
              "minimum": 1,
              "maximum": 15
            },
            "source_hint": {
              "type": "string",
              "required": false,
              "max_length": 20
            }
          }
        },
        "jobs": {
          "api": "jingge_jobs",
          "parameters": {
            "limit": {
              "type": "integer",
              "required": false,
              "minimum": 1,
              "maximum": 30
            }
          }
        },
        "sessions": {
          "api": "jingge_sessions",
          "parameters": {
            "platform": {
              "type": "string",
              "max_length": 40
            }
          }
        },
        "job": {
          "api": "jingge_job",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            }
          }
        },
        "voiceInfo": {
          "api": "jingge_voice_info",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "seconds": {
              "type": "integer",
              "required": false,
              "minimum": 15,
              "maximum": 120
            }
          }
        },
        "models": {
          "api": "jingge_models"
        },
        "modelUploads": { "api": "jingge_model_uploads" },
        "presetList": {
          "api": "jingge_preset_list"
        },
        "cacheStats": {
          "api": "jingge_cache_stats"
        },
        "studioStatus": {
          "api": "jingge_studio_status"
        },
        "audio": {
          "api": "jingge_audio",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "part": {
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 9
            },
            "chunk": {
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 99
            }
          }
        },
        "file": {
          "api": "jingge_file",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "chunk": {
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 99
            }
          }
        }
      },
      "actions": {
        "recheck": {
          "api": "jingge_recheck"
        },
        "unload": {
          "api": "jingge_unload"
        },
        "cancel": {
          "api": "jingge_cancel",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            }
          }
        },
        "cacheClean": {
          "api": "jingge_cache_clean",
          "parameters": {
            "force": { "type": "boolean", "required": false }
          }
        },
        "cacheConfig": {
          "api": "jingge_cache_config",
          "parameters": {
            "enabled": { "type": "boolean", "required": false },
            "max_age_days": { "type": "integer", "required": true, "minimum": 0, "maximum": 3650 },
            "max_size_mb": { "type": "integer", "required": true, "minimum": 0, "maximum": 102400 },
            "keep_jobs": { "type": "integer", "required": true, "minimum": 0, "maximum": 10000 },
            "check_interval_hours": { "type": "integer", "required": false }
          }
        },
        "save": {
          "api": "jingge_save",
          "parameters": {
            "payload": {
              "type": "string",
              "required": true,
              "max_length": 65536
            }
          }
        },
        "presetSave": {
          "api": "jingge_preset_save",
          "parameters": {
            "name": {
              "type": "string",
              "required": true,
              "max_length": 40
            },
            "payload": {
              "type": "string",
              "required": true,
              "max_length": 65536
            }
          }
        },
        "presetLoad": {
          "api": "jingge_preset_load",
          "parameters": {
            "name": {
              "type": "string",
              "required": true,
              "max_length": 40
            }
          }
        },
        "presetDelete": {
          "api": "jingge_preset_delete",
          "parameters": {
            "name": {
              "type": "string",
              "required": true,
              "max_length": 40
            }
          }
        },
        "render": {
          "api": "jingge_render",
          "parameters": {
            "payload": {
              "type": "string",
              "required": true,
              "max_length": 4096
            }
          }
        },
        "send": {
          "api": "jingge_send",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "stream_id": {
              "type": "string",
              "required": true,
              "max_length": 200
            },
            "group_id": {
              "type": "string",
              "max_length": 200
            },
            "user_id": {
              "type": "string",
              "max_length": 200
            },
            "platform": {
              "type": "string",
              "max_length": 40
            },
            "deliver_mode": {
              "type": "string",
              "max_length": 40
            }
          }
        },
        "sourceUpload": {
          "api": "jingge_source_upload",
          "parameters": {
            "op": { "type": "string", "required": true, "choices": ["start", "chunk", "finish", "cancel", "status"] },
            "token": { "type": "string", "max_length": 32 },
            "name": { "type": "string", "max_length": 255 },
            "size": { "type": "integer", "minimum": 1, "maximum": 33554432 },
            "index": { "type": "integer", "minimum": 0, "maximum": 1365 },
            "data": { "type": "string", "max_length": 32768 }
          }
        },
        "preview": {
          "api": "jingge_preview",
          "parameters": {
            "payload": {
              "type": "string",
              "required": true,
              "max_length": 65536
            }
          }
        },
        "save_to": {
          "api": "jingge_save_to",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "path": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        },
        "studioSeparate": {
          "api": "jingge_studio_separate",
          "parameters": {
            "dataset": {
              "type": "string",
              "required": true,
              "max_length": 48
            },
            "source": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        },
        "studioTrain": {
          "api": "jingge_studio_train",
          "parameters": {
            "model_name": {
              "type": "string",
              "required": true,
              "max_length": 48
            },
            "dataset": {
              "type": "string",
              "required": true,
              "max_length": 1024
            },
            "profile": {
              "type": "string",
              "required": false,
              "choices": ["refinegan", "hifigan"]
            },
            "epochs": {
              "type": "integer",
              "required": false,
              "minimum": 20,
              "maximum": 800
            },
            "batch_size": {
              "type": "integer",
              "required": false,
              "minimum": 1,
              "maximum": 16
            }
          }
        },
        "modelDelete": {
          "api": "jingge_model_delete",
          "parameters": {
            "model_id": { "type": "string", "required": true, "max_length": 64 },
            "confirm": { "type": "string", "required": true, "max_length": 64 }
          }
        },
        "modelImport": {
          "api": "jingge_model_import",
          "parameters": {
            "model_name": {
              "type": "string",
              "required": false,
              "max_length": 48
            },
            "pth_path": {
              "type": "string",
              "required": true,
              "max_length": 1024
            },
            "index_path": {
              "type": "string",
              "required": false,
              "max_length": 1024
            }
          }
        },
        "studioInspect": {
          "api": "jingge_studio_inspect",
          "parameters": {
            "dataset": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        },
        "studioClean": {
          "api": "jingge_studio_clean",
          "parameters": {
            "dataset": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        },
        "studioCancel": {
          "api": "jingge_studio_cancel"
        }
      }
    }
  ]
}
