{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages"
  ],
  "pages": [
    {
      "id": "studio",
      "title": "鲸歌",
      "description": "音色工作室：调参、试听与发送",
      "placement": "sidebar",
      "icon": "puzzle",
      "mode": "custom",
      "entry": "webui/index.html",
      "layout": "viewport",
      "queries": {
        "state": {
          "api": "jingge_state"
        },
        "sessions": {
          "api": "jingge_sessions",
          "parameters": {
            "platform": {
              "type": "string",
              "max_length": 40
            }
          }
        },
        "job": {
          "api": "jingge_job",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            }
          }
        },
        "models": {
          "api": "jingge_models"
        },
        "audio": {
          "api": "jingge_audio",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "part": {
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 9
            },
            "chunk": {
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 99
            }
          }
        },
        "file": {
          "api": "jingge_file",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "chunk": {
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 99
            }
          }
        }
      },
      "actions": {
        "save": {
          "api": "jingge_save",
          "parameters": {
            "payload": {
              "type": "string",
              "required": true,
              "max_length": 65536
            }
          }
        },
        "render": {
          "api": "jingge_render",
          "parameters": {
            "payload": {
              "type": "string",
              "required": true,
              "max_length": 4096
            }
          }
        },
        "send": {
          "api": "jingge_send",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "stream_id": {
              "type": "string",
              "required": true,
              "max_length": 200
            },
            "group_id": {
              "type": "string",
              "max_length": 64
            },
            "user_id": {
              "type": "string",
              "max_length": 64
            }
          }
        },
        "preview": {
          "api": "jingge_preview",
          "parameters": {
            "payload": {
              "type": "string",
              "required": true,
              "max_length": 65536
            }
          }
        },
        "save_to": {
          "api": "jingge_save_to",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "path": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        }
      }
    }
  ]
}